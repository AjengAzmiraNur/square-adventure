# ==== SQUARE ADVENTURE — konfigurasi frontend ====
# Salin menjadi .env lalu isi. Nilai VITE_* ikut terbundel ke aplikasi,
# jadi HANYA isi kunci publik (anon/publishable). JANGAN isi service role key di sini.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key

# Alamat backend FastAPI.
# Laptop: http://localhost:8000
# Android (HP di Wi-Fi yang sama): http://IP-LAPTOP:8000  atau URL HTTPS backend yang sudah di-deploy
VITE_API_URL=http://localhost:8000
