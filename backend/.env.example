# ==== SQUARE ADVENTURE — konfigurasi backend (FastAPI) ====
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# Supabase: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
# RAHASIA! Service role / secret key hanya boleh berada di backend.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key

# Rahasia untuk menurunkan password akun Supabase dari kode siswa.
# Buat string acak panjang, misalnya: python -c "import secrets;print(secrets.token_urlsafe(48))"
# JANGAN diubah setelah siswa didaftarkan.
STUDENT_PASSWORD_SECRET=ganti-dengan-string-acak-panjang

# Domain email internal untuk akun siswa (tidak ada email yang dikirim).
STUDENT_EMAIL_DOMAIN=siswa.squareadventure.id

# Origin frontend yang diizinkan (pisahkan dengan koma). capacitor://localhost & https://localhost untuk Android.
CORS_ORIGINS=https://ajengazmiranur.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,capacitor://localhost,http://localhost,https://localhost

LOGIN_RATE_LIMIT_PER_MINUTE=10
